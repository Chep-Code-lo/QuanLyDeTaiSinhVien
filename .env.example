# DATABASE
MYSQL_PORT=3307
MYSQL_APP_USER=ql_de_tai_app
MYSQL_APP_PASSWORD=Pass_mysql
MYSQL_ROOT_PASSWORD=_pass_mysql_root

# FRONTEND
FRONTEND_PORT=5173
FRONTEND_BIND_ADDRESS=127.0.0.1

# BACKEND
BACKEND_PORT=8080

APP_BASE_URL=ten_mien
CORS_ALLOWED_ORIGINS=ten_mien

# SESSION COOKIE
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax

# CSRF COOKIE
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_SAME_SITE=lax
CSRF_COOKIE_DOMAIN=

# EMAIL - BREVO SMTP
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=user_login
MAIL_PASSWORD=SMTP_key

MAIL_FROM=ten_email
MAIL_ALLOWED_FROM=ten_email

MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000

# EMAIL WORKER
EMAIL_ENABLED=true
EMAIL_WORKER_DELAY_MS=5000
EMAIL_MAX_PER_RUN=10
EMAIL_MAX_ATTEMPTS=4
EMAIL_RETRY_BASE_DELAY_SECONDS=60
EMAIL_CLAIM_TIMEOUT_MINUTES=15
EMAIL_DEADLINE_SCAN_DELAY_MS=900000
EMAIL_DEADLINE_SCAN_WINDOW_MINUTES=20

# APPLICATION
APP_DISPLAY_TIME_ZONE=Asia/Ho_Chi_Minh

#IP
NGINX_TRUSTED_PROXY_CIDRS=172.18.0.1/32
NGINX_REAL_IP_HEADER=X-Forwarded-For
TRUSTED_PROXY_ADDRESSES=frontend
